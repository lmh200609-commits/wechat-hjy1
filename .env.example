NODE_ENV=development
SERVICE_NAME=wenwan-api
SERVICE_VERSION=1.0.0
PORT=3000
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# Production should keep DATABASE_REQUIRED=true and DB_CONNECT_ON_START=true.
DATABASE_REQUIRED=false
DB_CONNECT_ON_START=false
AUTO_MIGRATE=false
ALLOW_DATABASE_SEED=true

MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_DATABASE=wenwan_mall
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_POOL_MAX=10
MYSQL_POOL_MIN=0
MYSQL_POOL_ACQUIRE_MS=10000
MYSQL_POOL_IDLE_MS=10000
MYSQL_LOGGING=false

# Leave empty for a WeChat Mini Program-only API. Comma-separate explicit browser origins if needed later.
CORS_ORIGINS=
