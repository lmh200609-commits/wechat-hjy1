NODE_ENV=development
SERVICE_NAME=wenwan-api
SERVICE_VERSION=1.0.0
PORT=3000
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# Non-secret WeChat CloudBase routing and trusted-header scope.
WECHAT_CLOUD_ENV_ID=prod-d9g4jzwa5832354ed
WECHAT_MINIPROGRAM_APP_ID=wx14a6f266208130dd
WECHAT_CLOUD_SERVICE_NAME=express-zaiy

# Production should keep DATABASE_REQUIRED=true and DB_CONNECT_ON_START=true.
DATABASE_REQUIRED=false
DB_CONNECT_ON_START=false
AUTO_MIGRATE=false
ALLOW_DATABASE_SEED=true

MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_DATABASE=wenwan_mall
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_POOL_MAX=10
MYSQL_POOL_MIN=0
MYSQL_POOL_ACQUIRE_MS=10000
MYSQL_POOL_IDLE_MS=10000
MYSQL_LOGGING=false

# Leave empty for a WeChat Mini Program-only API. Comma-separate explicit browser origins if needed later.
CORS_ORIGINS=

# Administrator authentication policy. Bootstrap password is sensitive and must stay empty in source control.
ADMIN_SESSION_TTL_SECONDS=7200
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_ACCOUNT_MAX_ATTEMPTS=5
ADMIN_LOCK_SECONDS=1800
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
